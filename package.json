{
  "name": "dagster-power-user",
  "displayName": "Dagster Power User",
  "description": "Enhanced VS Code support for Dagster with AI assistant, seamless setup, Airflow migration, and powerful dev tools",
  "version": "0.4.1",
  "publisher": "dagster-community",
  "repository": {
    "type": "git",
    "url": "https://github.com/dagster-io/dagster-power-user-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Debuggers"
  ],
  "keywords": [
    "dagster",
    "data",
    "pipeline",
    "lineage",
    "orchestration"
  ],
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/setup.py",
    "workspaceContains:**/dagster.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "ask-daggy",
        "name": "ask-daggy",
        "description": "Dagster AI assistant with project generation capabilities"
      }
    ],
    "commands": [
      {
        "command": "dagster.showDependencyGraph",
        "title": "📊 Show Dependency Graph",
        "category": "Dagster",
        "icon": "$(graph)"
      },
      {
        "command": "dagster.showImportAnalysis",
        "title": "🔍 Analyze Imports",
        "category": "Dagster",
        "icon": "$(symbol-module)"
      },
      {
        "command": "dagster.showAssetCatalog",
        "title": "📚 Asset Catalog",
        "category": "Dagster",
        "icon": "$(library)"
      },
      {
        "command": "dagster.showLineage",
        "title": "Show Asset Lineage",
        "category": "Dagster",
        "icon": "$(git-branch)"
      },
      {
        "command": "dagster.materializeAsset",
        "title": "Materialize Current Asset",
        "category": "Dagster",
        "icon": "$(play)"
      },
      {
        "command": "dagster.startWebserver",
        "title": "Start Local Webserver",
        "category": "Dagster",
        "icon": "$(server-process)"
      },
      {
        "command": "dagster.reloadCodeLocation",
        "title": "Reload Code Location",
        "category": "Dagster",
        "icon": "$(refresh)"
      },
      {
        "command": "dagster.showRunHistory",
        "title": "Show Run History",
        "category": "Dagster",
        "icon": "$(history)"
      },
      {
        "command": "dagster.quickStart",
        "title": "Quick Start - Launch Dagster Dev",
        "category": "Dagster",
        "icon": "$(rocket)"
      },
      {
        "command": "dagster.findDagsterInstance",
        "title": "Find Running Dagster Instance",
        "category": "Dagster",
        "icon": "$(search)"
      },
      {
        "command": "dagster.cloudConfigDoctor",
        "title": "Cloud Config Doctor",
        "category": "Dagster",
        "icon": "$(pulse)"
      },
      {
        "command": "dagster.findAssetReferences",
        "title": "Find Asset References",
        "category": "Dagster",
        "icon": "$(search)"
      },
      {
        "command": "dagster.goToAssetDefinition",
        "title": "Go to Asset Definition",
        "category": "Dagster",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dagster.publishToDagsterPlus",
