        "category": "Dagster",
        "icon": "$(search)"
      },
      {
        "command": "dagster.goToJobDefinition",
        "title": "Go to Job Definition",
        "category": "Dagster",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dagster.showJobLineage",
