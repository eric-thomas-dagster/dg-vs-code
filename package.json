      },
      {
        "command": "dagster.dgScaffoldJob",
        "title": "🏗️ DG Scaffold Job",
        "category": "Dagster DG CLI",
        "icon": "$(add)"
      },
      {
        "command": "dagster.dgScaffoldSchedule",
        "title": "🏗️ DG Scaffold Schedule",
        "category": "Dagster DG CLI",
        "icon": "$(add)"
      },
      {
        "command": "dagster.dgScaffoldDockerfile",
        "title": "🏗️ DG Scaffold Dockerfile",
        "category": "Dagster DG CLI",
        "icon": "$(add)"
      },
      {
        "command": "dagster.dgScaffoldGithubActions",
        "title": "🏗️ DG Scaffold GitHub Actions",
        "category": "Dagster DG CLI",
        "icon": "$(add)"
      },
      {
        "command": "dagster.instantProjectSetup",
        "title": "⚡ Instant Project Setup",
        "category": "Dagster Setup",
        "icon": "$(rocket)"
      },
      {
        "command": "dagster.cloneSetupDeploy",
        "title": "📥 Clone → Setup → Deploy",
        "category": "Dagster Setup",
        "icon": "$(repo-clone)"
      },
      {
        "command": "dagster.dgLaunchAsset",
        "title": "🎯 DG Launch Asset",
        "category": "Dagster DG CLI",
        "icon": "$(play)"
      },
      {
        "command": "dagster.dgLaunchJob",
        "title": "🔧 DG Launch Job",
        "category": "Dagster DG CLI",
        "icon": "$(play)"
      },
      {
        "command": "dagster.dgLaunchPartition",
        "title": "📅 DG Launch Partition",
        "category": "Dagster DG CLI",
        "icon": "$(calendar)"
      },
      {
        "command": "dagster.executeJob",
