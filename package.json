        "icon": "$(server-environment)"
      },
      {
        "command": "dagster.dgLaunch",
        "title": "🎯 DG Launch Run",
        "category": "Dagster DG CLI",
        "icon": "$(play)"
      },
      {
        "command": "dagster.dgListDefs",
